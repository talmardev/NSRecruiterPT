# Copia este ficheiro para ".env" e preenche os valores reais.
# Nunca commites o ".env"

# --- Identificacao (obrigatorio) ---
# Nome da regiao tal como aparece no NationStates (usado nos pedidos e no dashboard).
NS_REGION=

# Nacao responsavel por este script (oficial com autoridade de Communications).
# Entra tambem no User-Agent, como a API exige.
NS_NATION=

# Contacto adicional para o User-Agent (email ou outra nacao). Opcional --
# a nacao em NS_NATION ja chega para a API nao devolver 403, mas ajuda quem
# for contactado pela NationStates em caso de abuso reportado.
NS_CONTACT=

# --- Credenciais (obrigatorio) ---
# Client Key: gerada na pagina de Regional Control como oficial de Communications.
# Uma chave ativa por regiao, partilhada por todos os scripts da regiao.
NS_CLIENT_KEY=

# TGID e Secret Key: obtidos ao enviar o telegrama modelo para "tag:api",
# marcado como "recruitment" ao compor.
NS_TELEGRAM_ID=
NS_SECRET_KEY=

# --- Ritmo de envio (opcional) ---
# Intervalo entre envios, em segundos. O limite da plataforma e 180s para
# telegramas de recrutamento -- nunca baixes isto para menos de 180.
# 182 e o valor recomendado (180 exato + margem de seguranca).
SEND_INTERVAL_SECONDS=182

# --- Caminhos (opcional) ---
DB_PATH=data/nsrecruiter.db
LOCKFILE_PATH=data/nsrecruiter.lock
LOG_DIR=data/logs

# --- Registo (opcional) ---
# Um de: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Prioridade por bandeira (opcional) ---
# Lista separada por virgulas de bandeiras "preset" (pais real) que devem saltar
# para o topo da fila de envio quando uma nacao as tiver selecionada. Compara-se
# pelo nome do ficheiro da bandeira (ex: https://www.nationstates.net/images/flags/Portugal.svg
# -> "Portugal"), ignorando maiusculas/minusculas, espacos, underscores e hifens.
# So funciona para bandeiras preset (nunca para bandeiras carregadas/uploads).
# Nao gasta pedidos extra: vai "boleia" na mesma chamada que ja valida tgcanrecruit.
# Deixa vazio para desativar (comportamento antigo, fila so por ordem de chegada).
PRIORITY_FLAG_COUNTRIES=Portugal

# Backup automatico (opcional)
# Pasta fora deste projeto (drive externa, outro disco) onde gravar copias periodicas
# da base de dados. Deixa vazio para desativar.
PASTA_BACKUP=

# De quanto em quanto tempo gravar uma copia, em horas. Um destes valores:
# 1, 2, 3, 4, 5, 6, 12, 24. So tem efeito se PASTA_BACKUP estiver preenchida
# (usa 24 por omissao se deixares em branco com PASTA_BACKUP preenchida).
INTERVALO_BACKUP_HORAS=24
